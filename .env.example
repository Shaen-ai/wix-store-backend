APP_NAME="3D Store"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

CACHE_STORE=file

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=store3d
# DB_USERNAME=root
# DB_PASSWORD=

# Wix App credentials
WIX_APP_ID=
WIX_APP_SECRET=
WIX_3D_STORE_PUBLIC_KEY=

# Wix monetization: vendor product IDs from each paid plan (webhook payload is matched against these)
# WIX_PLAN_VENDOR_LIGHT=
# WIX_PLAN_VENDOR_BUSINESS=
# WIX_PLAN_VENDOR_BUSINESS_PRO=
# If no vendor id matches a paid webhook, tenants get this tier (default: business, legacy “premium”)
# WIX_DEFAULT_PAID_PLAN=business

# Dev mode (APP_ENV=local only): use token "dev" to bypass Wix auth
WIX_DEV_INSTANCE_TOKEN=dev
WIX_DEV_INSTANCE_ID=dev-local

# CORS – frontend URLs allowed to call this API
FRONTEND_WIDGET_URL=http://localhost:5174
FRONTEND_DASHBOARD_URL=http://localhost:5176
FRONTEND_SETTINGS_URL=http://localhost:5175

# Mail
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=25
MAIL_ENCRYPTION=null
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
MAIL_ATTACHMENT_MAX_BYTES=20971520

# PayPal
PAYPAL_SANDBOX=true
PAYPAL_IPN_URL=
PAYPAL_RETURN_URL=
PAYPAL_CANCEL_URL=

# Image-to-3D default provider (per-tenant keys in DB)
IMAGE_TO_3D_PROVIDER=meshy
IMAGE_TO_3D_API_KEY=

# Meshy — geometry fidelity: image_enhancement off + remesh off matches Meshy-6 defaults (see docs.meshy.ai/api/image-to-3d)
# MESHY_MODEL_TYPE=standard   # standard | lowpoly
# MESHY_SHOULD_TEXTURE=true
# MESHY_ENABLE_PBR=false
# MESHY_SHOULD_REMESH=false     # true = decimate to target_polycount (corners soften); false = highest-precision mesh
# MESHY_TOPOLOGY=triangle
# MESHY_TARGET_POLYCOUNT=30000  # when remesh on; avoid very low values
# MESHY_AI_MODEL=latest
# MESHY_IMAGE_ENHANCEMENT=false # false = preserve input photo (silhouette); true = Meshy may restyle the image
# MESHY_SYMMETRY_MODE=          # optional: off | auto | on — try off if asymmetric objects look mirrored
# MESHY_SAVE_PRE_REMESHED_MODEL=false
# MESHY_PREFER_PRE_REMESHED_GLB=false  # if remesh on: download pre-remesh GLB when available

# FX rates
FX_PROVIDER=exchangerate
FX_CACHE_TTL_MINUTES=60

# File storage
FILESYSTEM_DISK=local
# For S3:
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-west-1
# AWS_BUCKET=3dstore-assets

QUEUE_CONNECTION=database
